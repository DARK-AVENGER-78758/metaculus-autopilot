# =============================================================================
# Metaculus bot environment variables
#
# How to use:
#   1) Copy this file to `.env` in the same directory.
#        cp .env.template .env
#   2) Replace each `REPLACE_ME` below with your real key.
#   3) Save. The bot will read `.env` automatically on startup.
#
# In GitHub Actions, do NOT commit your `.env`. Instead, add each variable
# under Settings → Secrets and variables → Actions → New repository secret.
# =============================================================================


# ---- REQUIRED -----------------------------------------------------------------
# Your Metaculus bot account token. Without this, the bot cannot read questions
# or post forecasts. Get one at: https://www.metaculus.com/futureeval/participate/
METACULUS_TOKEN=REPLACE_ME


# ---- MODELS (REQUIRED) --------------------------------------------------------
# The bot runs on NVIDIA's free hosted models. Get a key at https://build.nvidia.com
# (sign in, open any model, "Get API Key"). It starts with nvapi-.
NVIDIA_NIM_API_KEY=REPLACE_ME

# Other providers are optional. Any litellm model name can be added to the model lists in
# the AUTOPILOT section below, and its key goes here.
# OPENROUTER_API_KEY=REPLACE_ME
# OPENAI_API_KEY=REPLACE_ME
# ANTHROPIC_API_KEY=REPLACE_ME


# ---- SEARCH / RESEARCH PROVIDERS (all optional) -------------------------------
# Improves research quality. The bot will fall back to LLM-only research
# if none of these are set.
#
# AskNews: https://asknews.app/
# ASKNEWS_CLIENT_ID=REPLACE_ME
# ASKNEWS_SECRET=REPLACE_ME
#
# Perplexity: https://docs.perplexity.ai/
# PERPLEXITY_API_KEY=REPLACE_ME
#
# Exa: https://exa.ai/
# EXA_API_KEY=REPLACE_ME


# ---- AUTOPILOT (all optional; see AUTOPILOT.md) --------------------------------
# Model lists, as comma-separated litellm names, strongest first. Forecasts come from the
# first three that answer; the rest are spares. The defaults are in models.py.
# FORECAST_MODELS=nvidia_nim/nvidia/nemotron-3-ultra-550b-a55b,nvidia_nim/moonshotai/kimi-k2.6
# UTILITY_MODELS=nvidia_nim/nvidia/nemotron-3-super-120b-a12b
# Requests per minute this process may send (NVIDIA allows about 40 per key):
# REQUESTS_PER_MINUTE=18
# Independent forecasts per question:
# FORECAST_SAMPLES=6
# "rewrite" has a second model criticise each forecast before it is rewritten:
# CRITIC=off
# A web-search model for extra research on top of the hooks:
# RESEARCH_MODEL=openrouter/perplexity/sonar
#
# AskNews single-key login (instead of ASKNEWS_CLIENT_ID + ASKNEWS_SECRET above):
# ASKNEWS_API_KEY=REPLACE_ME
#
# TypeSafe Jev: scores headlines instead of an LLM, and gives the critic a second opinion.
# https://docs.typesafe.ai/
# TYPESAFE_API_KEY=REPLACE_ME


# ---- INTEGRATIONS (optional) --------------------------------------------------
# See integrations/README.md for details.
# LightningRod: https://lightningrod.ai/
# LIGHTNINGROD_API_KEY=REPLACE_ME
